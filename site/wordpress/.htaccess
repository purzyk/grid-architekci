# BEGIN Redirects (old grid.net.pl content with no equivalent on the new site)
RewriteEngine On

# Projects archive moved to the homepage
RewriteRule ^projekt/?$ / [R=301,L]

# Individual project image "attachment" pages collapse to their project page
RewriteRule ^projekt/([^/]+)/[^/]+/?$ /projekt/$1/ [R=301,L]

# Team member pages have no equivalent — the team now lives on O nas
RewriteRule ^team(/.*)?$ /o-nas/ [R=301,L]

# O nas image attachment pages collapse to the page itself
RewriteRule ^o-nas/[^/]+/?$ /o-nas/ [R=301,L]

# No testimonials feature on the new site
RewriteRule ^testimonial(/.*)?$ / [R=301,L]

# No blog category archives
RewriteRule ^category/.*$ / [R=301,L]

# Project category archives are now a client-side filter on the homepage
RewriteRule ^projekt_cat/.*$ / [R=301,L]

# No author archive pages
RewriteRule ^author/.*$ / [R=301,L]

# Test/junk pages, never real content
RewriteRule ^testowa-ankieta/?$ / [R=301,L]
RewriteRule ^sample-page/?$ / [R=301,L]

# Blog removed entirely — individual posts and their image attachments
RewriteRule ^news/?$ / [R=301,L]
RewriteRule ^akupunktura-warszaty/?$ / [R=301,L]
RewriteRule ^wyroznienie-w-konkursie-fundacji-familijny-poznan/?$ / [R=301,L]
